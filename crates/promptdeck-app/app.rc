#include <windows.h>

IDI_APPICON ICON "ui/assets/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,1
PRODUCTVERSION 0,1,0,1
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "PromptDeck"
            VALUE "FileDescription", "PromptDeck"
            VALUE "FileVersion", "0.1.0-preview.1"
            VALUE "InternalName", "promptdeck"
            VALUE "OriginalFilename", "promptdeck.exe"
            VALUE "ProductName", "PromptDeck"
            VALUE "ProductVersion", "0.1.0-preview.1"
            VALUE "LegalCopyright", "Copyright (C) 2026 PromptDeck"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
