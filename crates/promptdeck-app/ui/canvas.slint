/* Hallmark · component: single-canvas · genre: modern-minimal
 * theme: studied-DNA (BlockHelm Workbench, design/design.md locked)
 * source: design/design.md semantic tokens via ui/theme.slint
 * states: 模式切换器 default · hover · active · selected；Source 输入 default · focus
 */

import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Strings } from "strings.slint";
import { MarkdownBlock, MarkdownSelection, MarkdownView } from "markdown.slint";

component SourceEditor inherits Rectangle {
    in-out property <string> text <=> input.text;
    out property <length> max-scroll: max(0px, scroll.content-height - scroll.visible-height);
    out property <float> scroll-fraction: root.max-scroll <= 0px
        ? 0
        : clamp(-scroll.content-y / root.max-scroll, 0, 1);
    callback edited();

    clip: true;
    background: transparent;

    public function scroll-to-fraction(fraction: float) {
        scroll.content-y = -fraction * root.max-scroll;
    }

    public function reset-scroll() {
        scroll.content-y = 0px;
    }

    scroll := ScrollView {
        width: 100%;
        height: 100%;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        content-width: self.visible-width;
        content-height: max(self.visible-height, input.preferred-height);

        input := TextInput {
            width: parent.width;
            single-line: false;
            wrap: word-wrap;
            font-family: Theme.font-body;
            font-size: Theme.text-base;
            color: Theme.ink;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.ink;
            page-height: scroll.visible-height;
            edited => { root.edited(); }
            cursor-position-changed(cpos) => {
                if (cpos.y + scroll.content-y < 0px) {
                    scroll.content-y = min(0px, max(parent.visible-height - self.height, -cpos.y));
                } else if (cpos.y + scroll.content-y > parent.visible-height - 20px) {
                    scroll.content-y = min(0px, max(parent.visible-height - self.height, parent.visible-height - cpos.y - 20px));
                }
            }
        }
    }

    Text {
        x: 0;
        y: 0;
        width: 100%;
        text: root.text == "" ? Strings.editor-placeholder : "";
        font-family: Theme.font-body;
        font-size: Theme.text-base;
        color: Theme.ink-muted;
        vertical-alignment: top;
    }

    public function focus-editor() {
        input.focus();
    }
}

component ModeSegment inherits FocusScope {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 28px;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    min-width: 64px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-input;
        background: root.selected
            ? (touch.pressed ? Theme.control : Theme.card)
            : (touch.pressed || touch.has-hover ? Theme.control-hover : transparent);
        animate background { duration: Theme.dur-fast; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }

    Text {
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.text-sm;
        font-weight: root.selected ? 600 : 400;
        color: root.selected ? Theme.ink : Theme.ink-2;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.clicked();
        }
    }
}

component ModeSwitcher inherits Rectangle {
    in property <bool> markdown-selected: false;
    callback mode-selected(mode: int);

    height: 32px;
    border-radius: Theme.radius-card;
    background: Theme.control;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        ModeSegment {
            label: Strings.mode-source;
            selected: !root.markdown-selected;
            clicked => { root.mode-selected(0); }
        }

        ModeSegment {
            label: Strings.mode-markdown;
            selected: root.markdown-selected;
            clicked => { root.mode-selected(1); }
        }
    }
}

export component Canvas inherits Rectangle {
    in-out property <string> title-text <=> title-input.text;
    in-out property <string> body-text <=> editor.text;
    in property <bool> has-selection: false;
    in property <bool> markdown-mode: false;
    in property <[MarkdownBlock]> markdown-blocks: [];
    in property <MarkdownSelection> markdown-selection;
    in-out property <int> markdown-geometry-tick: 0;
    in property <int> focus-request: 0;
    out property <bool> title-focused: title-input.has-focus;
    callback text-edited();
    callback mode-selected(mode: int);
    callback markdown-atom-geometry(block: int, atom: int, x: length, y: length, w: length, h: length);
    callback markdown-pressed(x: float, y: float);
    callback markdown-moved(x: float, y: float);
    callback markdown-released();
    callback markdown-double-clicked(x: float, y: float);
    callback copy-selection();
    callback select-all();

    private property <float> pending-scroll-fraction: 0;
    private property <bool> sync-pending: false;

    background: transparent;

    changed focus-request => {
        scroll-sync.stop();
        root.sync-pending = false;
        root.pending-scroll-fraction = 0;
        editor.reset-scroll();
        markdown.reset-scroll();
        if (!root.markdown-mode) {
            editor.focus-editor();
        }
    }

    changed markdown-mode => {
        root.pending-scroll-fraction = root.markdown-mode ? editor.scroll-fraction : markdown.scroll-fraction;
        root.sync-pending = true;
        scroll-sync.start();
        if (root.markdown-mode) {
            mode-anchor.focus();
        } else {
            editor.focus-editor();
        }
    }

    scroll-sync := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            scroll-sync.stop();
            if (root.sync-pending) {
                root.sync-pending = false;
                if (root.markdown-mode) {
                    markdown.scroll-to-fraction(root.pending-scroll-fraction);
                } else {
                    editor.scroll-to-fraction(root.pending-scroll-fraction);
                }
            }
        }
    }

    mode-anchor := FocusScope {
        width: 0;
        height: 0;

        KeyBinding {
            keys: @keys(Control + C);
            activated => { root.copy-selection(); }
        }

        KeyBinding {
            keys: @keys(Control + A);
            activated => { root.select-all(); }
        }
    }

    VerticalLayout {
        visible: !root.has-selection;
        spacing: Theme.space-2xs;

        Rectangle { vertical-stretch: 1; }

        Text {
            text: Strings.empty-canvas-title;
            width: 100%;
            font-size: Theme.text-md;
            font-weight: 600;
            color: Theme.ink-2;
            horizontal-alignment: center;
        }

        Text {
            text: Strings.empty-canvas-hint;
            width: 100%;
            font-size: Theme.text-sm;
            color: Theme.ink-muted;
            horizontal-alignment: center;
        }

        Rectangle { vertical-stretch: 2; }
    }

    HorizontalLayout {
        visible: root.has-selection;

        Rectangle {
            horizontal-stretch: 1;
            min-width: Theme.space-lg;
        }

        VerticalLayout {
            horizontal-stretch: 100;
            min-width: 0;
            max-width: Theme.content-max;
            padding-top: Theme.space-md;
            padding-bottom: Theme.space-sm;
            spacing: Theme.space-xs;

            Rectangle {
                height: 44px;

                title-input := TextInput {
                    width: 100%;
                    height: 100%;
                    single-line: true;
                    font-family: Theme.font-body;
                    font-size: Theme.text-title;
                    font-weight: 600;
                    color: Theme.ink;
                    vertical-alignment: center;
                    edited => { root.text-edited(); }
                }

                Text {
                    x: 0;
                    y: 0;
                    width: 100%;
                    height: 100%;
                    visible: title-input.text == "";
                    text: Strings.title-placeholder;
                    font-family: Theme.font-body;
                    font-size: Theme.text-title;
                    font-weight: 600;
                    color: Theme.ink-muted;
                    vertical-alignment: center;
                }

                Rectangle {
                    y: parent.height - self.height;
                    width: 100%;
                    height: title-input.has-focus ? 2px : 1px;
                    background: title-input.has-focus ? Theme.focus : Theme.rule-strong;
                    animate height, background { duration: Theme.dur-fast; easing: cubic-bezier(0.16, 1, 0.3, 1); }
                }
            }

            content-area := Rectangle {
                vertical-stretch: 1;
                min-height: 0px;

                editor := SourceEditor {
                    width: 100%;
                    height: 100%;
                    visible: !root.markdown-mode;
                    edited => { root.text-edited(); }
                }

                markdown := MarkdownView {
                    width: 100%;
                    height: 100%;
                    visible: root.markdown-mode;
                    blocks: root.markdown-blocks;
                    selection: root.markdown-selection;
                    geometry-tick: root.markdown-geometry-tick;
                    atom-geometry(block, atom, x, y, w, h) => { root.markdown-atom-geometry(block, atom, x, y, w, h); }
                    pointer-pressed(x, y) => { mode-anchor.focus(); root.markdown-pressed(x, y); }
                    pointer-moved(x, y) => { root.markdown-moved(x, y); }
                    pointer-released => { root.markdown-released(); }
                    pointer-double-clicked(x, y) => { root.markdown-double-clicked(x, y); }
                }
            }

            HorizontalLayout {
                spacing: 0;

                ModeSwitcher {
                    markdown-selected: root.markdown-mode;
                    mode-selected(mode) => { root.mode-selected(mode); }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: Theme.space-lg;
        }
    }
}
