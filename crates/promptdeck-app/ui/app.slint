import { Theme } from "theme.slint";
export { Theme }
import { Strings } from "strings.slint";
export { Strings }
import { SideRail } from "shell.slint";
import { LibraryPanel, PromptRow } from "library.slint";
import { Canvas } from "canvas.slint";
import { MarkdownBlock, MarkdownSelection } from "markdown.slint";

export component AppWindow inherits Window {
    title: Strings.app-title;
    icon: @image-url("assets/app-icon.png");
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 520px;
    background: Theme.paper;
    default-font-family: Theme.font-body;
    default-font-size: Theme.text-base;
    forward-focus: global-keys;

    in-out property <[PromptRow]> prompts: [];
    in-out property <string> selected-id: "";
    in-out property <string> title-text: "";
    in-out property <string> body-text: "";
    in-out property <int> editor-focus-request: 0;
    in-out property <bool> rail-expanded: false;
    in-out property <string> search-query: "";
    in-out property <string> search-empty-title: "";
    in-out property <bool> library-empty: false;
    in-out property <bool> markdown-mode: false;
    in-out property <bool> pinned: false;
    in-out property <[MarkdownBlock]> markdown-blocks: [];
    in-out property <MarkdownSelection> markdown-selection;
    in-out property <int> markdown-geometry-tick: 0;
    in-out property <bool> copy-feedback: false;
    out property <bool> title-focused: canvas.title-focused;

    callback new-prompt();
    callback select-prompt(id: string);
    callback text-edited();
    callback cycle-theme();
    callback toggle-rail();
    callback search-edited();
    callback mode-selected(mode: int);
    callback toggle-mode();
    callback toggle-pin();
    callback markdown-atom-geometry(block: int, atom: int, x: length, y: length, w: length, h: length);
    callback markdown-pressed(x: float, y: float);
    callback markdown-moved(x: float, y: float);
    callback markdown-released();
    callback markdown-double-clicked(x: float, y: float);
    callback copy-selection();
    callback copy-resolved();
    callback select-all();

    global-keys := FocusScope {
        KeyBinding {
            keys: @keys(Control + N);
            activated => { root.new-prompt(); }
        }

        KeyBinding {
            keys: @keys(Control + M);
            activated => { root.toggle-mode(); }
        }

        /* Ctrl+Shift+C 是全局复制快捷键：在编辑输入获得事件前拦截，
           避免被 TextInput 吞掉；普通 Ctrl+C 不受影响（不满足 Shift）。 */
        capture-key-pressed(event) => {
            if (event.modifiers.control && event.modifiers.shift && event.text.to-lowercase() == "c") {
                root.copy-resolved();
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;

            rail := SideRail {
                x: 0;
                y: 0;
                height: 100%;
                expanded: root.rail-expanded;
                cycle-theme => { root.cycle-theme(); }
                toggle-expanded => { root.toggle-rail(); }
            }

            panel-box := Rectangle {
                x: rail.width;
                y: 0;
                width: Theme.space-md + Theme.panel-width + Theme.space-sm;
                height: 100%;

                HorizontalLayout {
                    padding-left: Theme.space-md;
                    padding-top: Theme.space-md;
                    padding-right: Theme.space-sm;
                    padding-bottom: Theme.space-md;

                    LibraryPanel {
                        prompts: root.prompts;
                        selected-id: root.selected-id;
                        search-query <=> root.search-query;
                        search-empty-title: root.search-empty-title;
                        library-empty: root.library-empty;
                        new-prompt => { root.new-prompt(); }
                        select-prompt(id) => { root.select-prompt(id); }
                        search-edited => { root.search-edited(); }
                    }
                }
            }

            canvas := Canvas {
                x: rail.width + panel-box.width;
                y: 0;
                width: parent.width - rail.width - panel-box.width;
                height: 100%;
                has-selection: root.selected-id != "";
                pinned: root.pinned;
                markdown-mode: root.markdown-mode;
                markdown-blocks: root.markdown-blocks;
                markdown-selection: root.markdown-selection;
                markdown-geometry-tick: root.markdown-geometry-tick;
                copy-feedback: root.copy-feedback;
                title-text <=> root.title-text;
                body-text <=> root.body-text;
                focus-request: root.editor-focus-request;
                text-edited => { root.text-edited(); }
                mode-selected(mode) => { root.mode-selected(mode); }
                toggle-pin => { root.toggle-pin(); }
                markdown-atom-geometry(block, atom, x, y, w, h) => { root.markdown-atom-geometry(block, atom, x, y, w, h); }
                markdown-pressed(x, y) => { root.markdown-pressed(x, y); }
                markdown-moved(x, y) => { root.markdown-moved(x, y); }
                markdown-released => { root.markdown-released(); }
                markdown-double-clicked(x, y) => { root.markdown-double-clicked(x, y); }
                copy-selection => { root.copy-selection(); }
                select-all => { root.select-all(); }
            }
        }
    }
}
