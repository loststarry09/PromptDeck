import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { Strings } from "strings.slint";
import { AppIcon } from "icons.slint";
import { TagChip } from "tagchip.slint";
import { FocusRing } from "focusring.slint";

export struct PromptRow {
    id: string,
    title: string,
    updated-label: string,
    pinned: bool,
    tags: [string],
    tag-overflow: int,
}

component NewButton inherits FocusScope {
    callback clicked();

    out property <bool> hovering: touch.has-hover;
    height: 32px;
    min-width: 72px;

    private property <bool> keyboard-focus: false;
    focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
    focus-lost => { root.keyboard-focus = false; }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            root.clicked();
            return accept;
        }
        return reject;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius-input;
        background: touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent);
        animate background { duration: Theme.dur-fast; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: Theme.space-xs;
        spacing: 6px;

        VerticalLayout {
            alignment: center;

            AppIcon {
                source: @image-url("icons/action-add.svg");
                tint: Theme.accent-ink;
                icon-size: 16px;
            }
        }

        Text {
            text: Strings.action-new;
            font-size: Theme.text-sm;
            font-weight: 600;
            color: Theme.accent-ink;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    /* accent 底上的主 CTA：焦点环改用 paper，保证与按钮底色对比可见。 */
    FocusRing {
        shown: root.keyboard-focus;
        radius: Theme.radius-input;
        ring-color: Theme.paper;
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    callback edited();
    callback move-selection(delta: int);
    callback open-selected();
    callback escape();

    public function focus-input() {
        input.focus();
    }

    height: 32px;
    border-radius: Theme.radius-input;
    background: Theme.control;
    clip: true;

    input := TextInput {
        x: Theme.space-xs;
        width: parent.width - 2 * Theme.space-xs;
        height: parent.height;
        single-line: true;
        font-family: Theme.font-body;
        font-size: Theme.text-base;
        color: Theme.ink;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.ink;
        vertical-alignment: center;
        edited => { root.edited(); }
        accepted => { root.open-selected(); }
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (event.text == Key.Escape) {
                root.escape();
                return accept;
            }
            return reject;
        }
    }

    Text {
        x: Theme.space-xs;
        width: parent.width - 2 * Theme.space-xs;
        height: parent.height;
        visible: input.text == "" && input.preedit-text == "";
        text: Strings.search-placeholder;
        font-family: Theme.font-body;
        font-size: Theme.text-base;
        color: Theme.ink-muted;
        vertical-alignment: center;
    }

    Rectangle {
        x: Theme.radius-input;
        y: parent.height - self.height;
        width: parent.width - 2 * Theme.radius-input;
        height: 2px;
        border-radius: 1px;
        background: Theme.focus;
        opacity: input.has-focus ? 1 : 0;
        animate opacity { duration: Theme.dur-fast; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }
}

component LibraryRow inherits Rectangle {
    in property <string> title;
    in property <string> updated-label;
    in property <bool> pinned: false;
    in property <bool> selected: false;
    in property <[string]> tags: [];
    in property <int> tag-overflow: 0;
    in property <string> filter-tag: "";
    callback clicked();
    callback toggle-tag(tag: string);

    /* 列表行内容锁 54px（design-foundations）；标签并入元数据行，不新增行高。 */
    private property <length> content-height: 54px;

    height: content-height + 8px;
    clip: true;

    pill := Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: root.content-height;
        border-radius: Theme.radius-input;
        background: root.selected ? Theme.control : (touch.has-hover ? Theme.control-hover : transparent);
        animate background { duration: Theme.dur-fast; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.selected ? 3px : 0px;
        height: root.content-height - Theme.space-md;
        border-radius: 2px;
        background: Theme.accent;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.rule;
    }

    /* 行级点击面先声明，让行内标签 chip 的点击面叠在其上、优先响应。
       行不是 Tab 停靠点（列表选择走搜索框的 ↑/↓），避免无可见指示的焦点陷阱。 */
    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        x: 14px;
        width: parent.width - 22px;
        y: (parent.height - root.content-height) / 2;
        height: root.content-height;
        alignment: center;
        spacing: 2px;

        HorizontalLayout {
            spacing: 6px;

            if root.pinned : VerticalLayout {
                alignment: center;

                AppIcon {
                    source: @image-url("icons/pin.svg");
                    icon-size: 12px;
                    tint: Theme.ink-muted;
                }
            }

            Text {
                text: root.title;
                horizontal-stretch: 1;
                font-size: Theme.text-base;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }

            /* 有标签时把时间让到标题行右侧，给标签腾出完整一行宽度。 */
            if root.tags.length > 0 || root.tag-overflow > 0 : Text {
                text: root.updated-label;
                min-width: 0px;
                font-size: Theme.text-sm;
                color: Theme.ink-muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.tags.length > 0 || root.tag-overflow > 0 : HorizontalLayout {
            spacing: Theme.space-3xs;

            for tag in root.tags : TagChip {
                label: tag;
                selected: tag == root.filter-tag;
                height: 18px;
                max-width: 96px;
                clicked => { root.toggle-tag(tag); }
            }

            if root.tag-overflow > 0 : Text {
                text: "+" + root.tag-overflow;
                font-size: Theme.text-xs;
                color: Theme.ink-muted;
                vertical-alignment: center;
            }
        }

        if root.tags.length == 0 && root.tag-overflow == 0 : Text {
            text: root.updated-label;
            font-size: Theme.text-sm;
            color: Theme.ink-muted;
            overflow: elide;
        }
    }
}

component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> hint;

    vertical-stretch: 1;

    VerticalLayout {
        Rectangle { vertical-stretch: 1; }

        Text {
            text: root.title;
            width: 100%;
            font-size: Theme.text-base;
            font-weight: 600;
            color: Theme.ink-2;
            horizontal-alignment: center;
        }

        Text {
            text: root.hint;
            width: 100%;
            font-size: Theme.text-sm;
            color: Theme.ink-muted;
            horizontal-alignment: center;
        }

        Rectangle { vertical-stretch: 2; }
    }
}

export component LibraryPanel inherits Rectangle {
    in property <[PromptRow]> prompts;
    in property <string> selected-id: "";
    in-out property <string> search-query;
    in property <string> search-empty-title;
    in property <bool> library-empty;
    in property <string> tag-filter: "";
    in property <int> focus-request: 0;
    in property <int> selected-index: -1;
    callback new-prompt();
    callback select-prompt(id: string);
    callback search-edited();
    callback toggle-tag-filter(tag: string);
    callback clear-tag-filter();
    callback move-selection(delta: int);
    callback open-selected();

    /* 列表行高：内容 54px + 分隔留白 8px（design-foundations）。 */
    private property <length> row-height: 62px;

    public function focus-search() {
        search-field.focus-input();
    }

    changed focus-request => { root.focus-search(); }

    /* 键盘选择后把选中行滚入可视区，长列表也能跟上。 */
    changed selected-index => {
        if (root.selected-index < 0 || list.height <= 0px) {
            return;
        }
        let item-y = root.selected-index * root.row-height;
        if (item-y < -list.content-y) {
            list.content-y = -item-y;
        } else if (item-y + root.row-height > -list.content-y + list.height) {
            list.content-y = -(item-y + root.row-height - list.height);
        }
    }

    background: Theme.panel;
    border-radius: Theme.radius-panel;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 15px;
    drop-shadow-offset-y: 2px;
    clip: true;

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-xs;

        HorizontalLayout {
            spacing: Theme.space-2xs;

            Text {
                text: Strings.library-heading;
                horizontal-stretch: 1;
                font-size: Theme.text-lg;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
                vertical-alignment: center;
            }

            NewButton {
                clicked => { root.new-prompt(); }
            }
        }

        search-field := SearchField {
            text <=> root.search-query;
            edited => { root.search-edited(); }
            move-selection(delta) => { root.move-selection(delta); }
            open-selected => { root.open-selected(); }
            escape => {
                if (root.search-query != "") {
                    root.search-query = "";
                    root.search-edited();
                }
            }
        }

        if root.tag-filter != "" : HorizontalLayout {
            height: 22px;
            spacing: Theme.space-3xs;

            Text {
                text: Strings.tag-filter-prefix;
                font-size: Theme.text-xs;
                color: Theme.ink-muted;
                vertical-alignment: center;
            }

            TagChip {
                label: root.tag-filter;
                selected: true;
                clicked => { root.clear-tag-filter(); }
            }

            Rectangle { horizontal-stretch: 1; }

            clear-hit := TouchArea {
                width: 36px;
                height: 22px;
                mouse-cursor: pointer;

                Text {
                    text: Strings.tag-filter-clear;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.text-xs;
                    color: clear-hit.has-hover ? Theme.ink : Theme.ink-2;
                }

                clicked => { root.clear-tag-filter(); }
            }
        }

        if root.prompts.length == 0 && root.library-empty : EmptyState {
            title: Strings.empty-library-title;
            hint: Strings.empty-library-hint;
        }

        if root.prompts.length == 0 && !root.library-empty && root.search-empty-title != "" : EmptyState {
            title: root.search-empty-title;
            hint: Strings.empty-search-hint;
        }

        if root.prompts.length == 0 && !root.library-empty && root.search-empty-title == "" && root.tag-filter != "" : EmptyState {
            title: Strings.tag-empty-title;
            hint: Strings.tag-empty-hint;
        }

        list := ListView {
            visible: root.prompts.length > 0;
            vertical-stretch: 1;

            for row in root.prompts : LibraryRow {
                title: row.title;
                updated-label: row.updated-label;
                pinned: row.pinned;
                tags: row.tags;
                tag-overflow: row.tag-overflow;
                filter-tag: root.tag-filter;
                selected: row.id == root.selected-id;
                clicked => { root.select-prompt(row.id); }
                toggle-tag(tag) => { root.toggle-tag-filter(tag); }
            }
        }
    }
}
